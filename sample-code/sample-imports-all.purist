from Builtin.list require [List]
from package.package require [MyClass]
from private:git@github.com/<owner>/project-name[:<label|branch>] require [ProjectClass] // need ssh file
from public:https@github.com/<owner>/project-name[:<label|branch] require [ProjectClass] // only public repos
from library:absolute-path-to-library-name require [LibraryClass] // run nm to get exposed symbols, or find .h in /usr/include


