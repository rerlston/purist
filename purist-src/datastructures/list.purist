class List<T> {
	Array value

	public constructor() {
		this.value = new Array<T>()
	}

	public constructor(T[] value) {
		this.value = value
	}

	public toString() string {
		response = "["
		for entry in this.value {
			response = "{response},{entry}"
		}
		response = "{response}]"
		return response
	}
}